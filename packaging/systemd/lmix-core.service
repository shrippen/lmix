# lmix-core without GUI (OPS.1): loads the show at start, serves the API,
# the browser pages, the text protocol and /metrics. Consoles connect to
# it; stopping it leaves the engine and its outputs running.
#
# Settings go into ~/.config/lmix/core.env, for example:
#   LMIX_SHOW=/home/me/shows/sunday.lmix
#   LMIX_LISTEN=0.0.0.0:8200
#   LMIX_TCP=0.0.0.0:8201
#   LMIX_SHORTCUTS=…/shortcuts.json   (shortcuts for all shows; default ~/.config/lmix/)
#   LMIX_LAYOUT_TEMPLATES=…/layout-templates.json   (layout templates; default ~/.config/lmix/)
#   LMIX_PASSWORD=…   (needed from the network; this machine needs none)
#   LMIX_OPEN_PAGES=tally,keys   (pages usable without the password)
#   LMIX_TALLY_HTTP=http://192.168.1.60/tally   (tally lights over HTTP)
#   LMIX_GOOGLE_API_KEY=…   (Google Sheets as data sources; keep core.env private)
[Unit]
Description=lmix control core
Wants=lmix-strom.service
After=lmix-strom.service

[Service]
EnvironmentFile=-%E/lmix/core.env
ExecStart=%h/.local/bin/lmix-core --strom http://127.0.0.1:8099
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
